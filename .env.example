# Puerto del servidor
PORT=20223

# Base de datos
DATABASE_URL="mysql://usuario:password@localhost:3306/nombre_db"

# JWT Secret Key
SECRET_KEY=DalePlay182182

# Google Maps API Key (requerido para cálculo de delivery con coordenadas)
GOOGLE_MAPS_API_KEY=tu_api_key_aqui

# Google Cloud Vision (OCR de la carta para tachar agotados). API key con SOLO Cloud Vision API habilitada.
# Sin esta key el indexado se omite y el bot manda el link de la carta como siempre (falla-abierto).
GOOGLE_VISION_API_KEY=
# Tope de lineas de texto detectadas para el tachado de carta (cartas cortas / menu del dia).
# Mas lineas que esto => el tachado se desactiva para esa imagen y el bot manda el link normal.
CARTA_TACHADO_MAX_LINEAS=40

# Saldo chatbot (Fase 2): Niubiz + acreditación en chatbot-go
NIUBIZ_BASE_URL=https://apisandbox.vnforappstest.com
NIUBIZ_STATIC_JS_URL=https://static-content-qas.vnforapps.com/v2/js/checkout.js?qa=true
NIUBIZ_USER=
NIUBIZ_PASS=
NIUBIZ_MERCHANT_ID=
CHATBOT_GO_URL=http://localhost:8080
CHATBOT_BILLING_KEY=

# Resumen de pedido en imagen: base de la carpeta legacy donde vive el logo
# real de la sede (nombre en conf_print.logo). Debe terminar en "/".
# Dev: http://192.168.1.65/restobar/print/logo/
# RESTOBAR_LOGO_BASE_URL=https://restobar.papaya.com.pe/print/logo/

# Secreto compartido con backend-pedidos para la emision de comprobantes del
# bot (/bot/generar-comprobante). El MISMO valor va en el .env de backend-pedidos.
# Vacio = la generacion de comprobantes del bot queda apagada.
CHATBOT_BOT_KEY=

# Encuesta publica (encuesta.papaya.com.pe). Secreto HMAC compartido con el POS legacy (private/encuesta_secrets.php).
# Minimo 32 caracteres; sin el, /encuesta-publica responde 503. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCUESTA_SECRET=
# IPs de los proxies propios delante de la API, separadas por coma (IP real para el rate limit de la encuesta).
# En produccion: la del proxy de papaya.com.pe (si no esta en la misma maquina) y la IP publica del VPS de la encuesta.
# loopback ya esta incluido. Vacio en local.
TRUST_PROXY_IPS=
